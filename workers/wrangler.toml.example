# Template. Copy to wrangler.toml and fill in your own values:
#
#   cp wrangler.toml.example wrangler.toml
#
# wrangler.toml itself is gitignored on purpose. This repo is public, and the real file names
# our Cloudflare account, our KV and Hyperdrive resources, and the identity provider's
# hostnames. None of them are credentials, but they describe live infrastructure, so they stay
# on the development machines (synced privately) rather than in git.

name = "simtrader"
main = "src/index.ts"
compatibility_date = "2024-05-29"
compatibility_flags = ["nodejs_compat"]
account_id = "YOUR_CLOUDFLARE_ACCOUNT_ID"

# Vars available in all environments (non-secret)
[vars]
ENVIRONMENT = "development"
# BudgetApp sign-in (ST-008). BudgetApp is the only identity provider; the urbanlife issuer
# is retired. Local dev points at docker-compose BudgetApp and `wrangler dev` on :8787.
SSO_AUDIENCE = "simtrader"
SSO_CLIENT_ID = "simtrader"
BUDGETAPP_ISSUER = "http://localhost:8000"
BUDGETAPP_JWKS_URL = "http://localhost:8000/.well-known/jwks.json"
BUDGETAPP_TOKEN_URL = "http://localhost:8000/api/v1/sso/token"
BUDGETAPP_CONNECT_URL = "http://localhost:5173/connect"
SIMTRADER_PUBLIC_URL = "http://localhost:8787"

# KV namespace for sessions
# Run `make workers-kv-create` to create these and paste the IDs below.
[[kv_namespaces]]
binding = "KV"
id = "YOUR_DEV_KV_ID"
preview_id = "YOUR_DEV_KV_PREVIEW_ID"

# Hyperdrive — reaches Postgres on vizneo-docker through a Cloudflare Tunnel gated by an
# Access service token. Credentials live in the Hyperdrive config, not here.
[[hyperdrive]]
binding = "HYPERDRIVE"
id = "YOUR_HYPERDRIVE_CONFIG_ID"

# Secrets — set via `wrangler secret put <NAME>` (never put in this file):
#   DATABASE_URL                 — fallback only; the Hyperdrive binding above is the real path
#   TOKEN_ENCRYPTION_KEY         — 64 hex chars (32 random bytes), for Saxo token AES-256-GCM
#   SIMTRADER_SSO_CLIENT_SECRET  — secret half of the `simtrader` client registered in BudgetApp

[env.staging]
name = "simtrader-staging"
vars = { ENVIRONMENT = "staging", SSO_AUDIENCE = "simtrader", SSO_CLIENT_ID = "simtrader", BUDGETAPP_ISSUER = "https://api.budgetapp.example.com", BUDGETAPP_JWKS_URL = "https://api.budgetapp.example.com/.well-known/jwks.json", BUDGETAPP_TOKEN_URL = "https://api.budgetapp.example.com/api/v1/sso/token", BUDGETAPP_CONNECT_URL = "https://budgetapp.example.com/connect", SIMTRADER_PUBLIC_URL = "https://YOUR_STAGING_HOST" }

[[env.staging.kv_namespaces]]
binding = "KV"
id = "YOUR_STAGING_KV_ID"
preview_id = "YOUR_STAGING_KV_PREVIEW_ID"

[env.production]
name = "simtrader-production"
vars = { ENVIRONMENT = "production", SSO_AUDIENCE = "simtrader", SSO_CLIENT_ID = "simtrader", BUDGETAPP_ISSUER = "https://api.budgetapp.example.com", BUDGETAPP_JWKS_URL = "https://api.budgetapp.example.com/.well-known/jwks.json", BUDGETAPP_TOKEN_URL = "https://api.budgetapp.example.com/api/v1/sso/token", BUDGETAPP_CONNECT_URL = "https://budgetapp.example.com/connect", SIMTRADER_PUBLIC_URL = "https://YOUR_PRODUCTION_HOST" }

[[env.production.kv_namespaces]]
binding = "KV"
id = "YOUR_PRODUCTION_KV_ID"
